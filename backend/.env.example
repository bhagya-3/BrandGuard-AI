APP_NAME=BrandGuard AI
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Local development; use a PostgreSQL URL and psycopg driver in deployment.
DATABASE_URL=sqlite:///./brandguard.db
AUTO_CREATE_TABLES=true
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=local
FILE_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=20

# Use a unique random value outside local development.
JWT_SECRET_KEY=replace-with-a-random-secret-before-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Set STORAGE_BACKEND=minio and provide these values to use MinIO.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=brandguard-files
MINIO_SECURE=false

# Set STORAGE_BACKEND=s3 to use AWS S3.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Set STORAGE_BACKEND=azure_blob to use Azure Blob Storage.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=brandguard-files

# Optional AI suggestions; setting this sends review text to the provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Optional integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
SLACK_WEBHOOK_URL=